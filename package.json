{
    "name": "@hexlet/code",
    "version": "1.0.0",
    "description": "Form generator library",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "author": "Anastasia Svalova",
    "scripts": {
        "build": "tsc",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier . --write"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@vitest/coverage-v8": "^5.1.0",
        "eslint": "^10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.14.0",
        "prettier": "^3.9.10",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.72.1",
        "vitest": "^5.1.0"
    }
}
